{:aliases
 {:antq {:deps {com.github.liquidz/antq {:mvn/version "2.11.1264"}}
         :main-opts ["-m" "antq.core"]}
  :cljs-deps {:extra-deps {com.andrewmcveigh/cljs-time #:mvn{:version "0.5.2"}
                           lambdaisland/uri #:mvn{:version "1.19.155"}
                           mount/mount #:mvn{:version "0.1.20"}
                           re-frame/re-frame #:mvn{:version "1.4.3"}
                           reagent/reagent #:mvn{:version "1.2.0"}
                           thheller/shadow-cljs #:mvn{:version "2.28.20"}}
              :extra-paths ["src/cljs" "src/cljc" "resources"]}
  :cljs-dev-deps {:extra-deps
                  {binaryage/devtools #:mvn{:version "1.0.7"}
                   day8.re-frame/http-fx #:mvn{:version "0.2.4"}
                   day8.re-frame/re-frame-10x #:mvn{:version "1.9.10"}
                   day8.re-frame/tracing #:mvn{:version "0.6.2"}
                   no.cjohansen/portfolio #:mvn{:version "2024.09.25"}}
                  :extra-paths ["test/cljs"
                                "test/cljc"
                                "test/resources"
                                "env/development/src/cljs/"
                                "env/development/src/cljc/"]}
  :common-test
  {:exec-fn cognitect.test-runner.api/test
   :extra-deps {com.cognitect/test-runner
                {:git/url "https://github.com/cognitect-labs/test-runner"
                 :sha "3f288f1f16d167723ad87cc35b1dfee3c1681e10"}
                org.clojure/tools.namespace #:mvn{:version "1.5.0"}
                org.clojure/tools.reader #:mvn{:version "1.5.0"}}
   :extra-paths ["test/clj" "test/cljc" "test/resources"]
   :jvm-opts ["-Dheph-conf=env/test/config.edn,env/common_config.edn"]
   :main-opts ["-m"
               "cognitect.test-runner"
               "-r"
               ".*-test.*"
               "-d"
               "test/clj"
               "-d"
               "test/cljc"]}
  :env-development-repl
  {:extra-deps {org.clojars.hephaistox/automaton-web-dev {:mvn/version "0.4.0"}}
   :extra-paths ["env/development/resources"
                 "env/development/src/clj"
                 "env/development/src/cljc"]
   :jvm-opts
   ["-Dclojure.tools.logging.factory=clojure.tools.logging.impl/log4j2-factory"
    "-Dlog4j.configurationFile=resources/log_config/appenders.properties,resources/log_config/log4j2.properties"
    "-Dheph-conf=env/development/config.edn,env/common_config.edn"]
   :main-opts ["-m" "mateuszmazurczak.repl.entry-point"]}}
 :deps {mount/mount #:mvn{:version "0.1.20"}
        no.cjohansen/portfolio #:mvn{:version "2024.09.25"}
        org.clojars.hephaistox/automaton-core #:mvn{:version "1.6.0"}
        org.clojars.hephaistox/automaton-web #:mvn{:version "2.3.0"}}
 :paths ["src/clj" "src/cljc" "resources"]}
